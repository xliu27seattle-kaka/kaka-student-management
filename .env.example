# Copy this file to `.env` to override the defaults. `.env` is git-ignored.
# The stack starts without any `.env`: every value below has a working demo default.

# ── Host ports ────────────────────────────────────────────────
FRONTEND_PORT=4200
BACKEND_PORT=8080
DB_PORT=5432
MAILBOX_UI_PORT=8025

# ── Database (demo values, safe to publish) ───────────────────
POSTGRES_DB=kaka_sms
POSTGRES_USER=kaka
POSTGRES_PASSWORD=kaka_dev_password

# ── Demo data ─────────────────────────────────────────────────
# Demo accounts are loaded on first start. Set to false for an empty system.
APP_DEMO_DATA=true

# ── Security (demo values; change for any real deployment) ────
JWT_SECRET=kaka-demo-jwt-secret-change-me-0123456789abcdef0123456789abcdef
JWT_TTL_MINUTES=120
INTERNAL_API_KEY=kaka-internal-dev-key

# ── Mail ──────────────────────────────────────────────────────
# Default: every email lands in the local inbox at http://localhost:8025
MAIL_HOST=mailbox
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kaka-sms.example
# A failed send is retried this many times, then given up on.
EMAIL_MAX_RETRIES=2

# To really send through Gmail, use these instead:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM=your.address@gmail.com
